# Documentation: https://docs.fastlane.tools/actions/

default_platform :ios

platform :ios do
  desc "Runs the HackerNewsKit unit tests and the UI tests"
  lane :test do
    run_tests(scheme: "HackerNews")
  end

  desc "Captures and frames App Store screenshots"
  lane :screenshots do
    capture_screenshots
    frame_screenshots(white: true)
  end

  desc "Submit a new Beta Build to Apple TestFlight"
  lane :beta do
    increment_build_number
    build_app(scheme: "HackerNews")
    screenshots
    upload_to_testflight
  end

  desc "Deploy a new version to the App Store"
  lane :release do
    screenshots
    build_app(scheme: "HackerNews")
    upload_to_app_store(force: true)
  end
end
